# ===== ตั้งค่าระบบ AI วินิจฉัยโรคแตงโม =====
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของคุณ:  cp .env.example .env

# API key ของ Claude (ขอได้ที่ https://console.anthropic.com/settings/keys)
# ถ้าไม่ใส่ ระบบยังทำงานได้ในโหมดออฟไลน์ (วิเคราะห์สีและลักษณะแผลด้วย OpenCV-style heuristic
# + ตอบคำถามจากคลังความรู้ด้วยการค้นคืน) แต่ความแม่นยำจะต่ำกว่ามาก
ANTHROPIC_API_KEY=

# โมเดลที่ใช้ (ค่าเริ่มต้นคือรุ่นที่แม่นที่สุดสำหรับงานวิเคราะห์ภาพ)
MELON_MODEL=claude-opus-5-5

# ระดับความละเอียดในการคิด: low | medium | high | xhigh | max
MELON_EFFORT_DIAGNOSE=high
MELON_EFFORT_CHAT=medium

# เปิด server-side fallback เมื่อคำขอถูกปฏิเสธโดยตัวกรองความปลอดภัย (แนะนำให้เปิด)
MELON_ENABLE_FALLBACK=true

# ขนาดภาพสูงสุดที่รับ (MB) และขนาดด้านยาวที่จะย่อก่อนส่งให้ AI (px)
MELON_MAX_UPLOAD_MB=12
MELON_IMAGE_MAX_EDGE=1400

# โมเดล ONNX ที่เทรนเอง (ไม่บังคับ) — ดู scripts/train_model.py
# MELON_ONNX_MODEL=models/watermelon_cls.onnx
# MELON_ONNX_LABELS=models/watermelon_cls.labels.json

# ที่อยู่/พอร์ตเซิร์ฟเวอร์
MELON_HOST=0.0.0.0
MELON_PORT=8000
